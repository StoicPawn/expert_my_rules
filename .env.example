# Local-first defaults
AWB_LOCAL_MODEL=qwen3:8b
AWB_PLANNER_MODEL=qwen3:8b

# Only needed for native installation or a custom Ollama endpoint.
# Docker Compose uses its bundled Ollama service automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional cloud escalation. A ChatGPT subscription does not include API usage.
# Even with a key, no cloud call is made unless the workspace also enables
# escalation and configures a positive budget and call cap.
OPENAI_API_KEY=

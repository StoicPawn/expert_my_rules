# Expert My Rules inference placement.
# local  = bundled Ollama container on this machine
# remote = Expert My Rules stays here, Ollama runs on another private machine
AWB_INFERENCE_MODE=local
AWB_PORT=8100

# Local-first heterogeneous ensemble.
AWB_PLANNER_MODEL=qwen3:4b
AWB_DIRECTOR_MODEL=qwen3:4b
AWB_WORKER_MODEL=qwen3:4b
AWB_REVIEWER_MODEL=llama3.2:3b
AWB_VERIFIER_MODEL=gemma3:4b

# Legacy constructive-model override. It affects Director/Worker only unless
# their role-specific variables above are set.
AWB_LOCAL_MODEL=qwen3:4b

# Slow-machine inference policy.
# Ollama generation is streamed and has NO wall-clock generation deadline.
# Every stall interval Expert checks Ollama liveness; a healthy service may keep
# working for hours. Only repeated failed health probes after a silent stream make
# the call a technical failure. No generated/thinking text is exposed as telemetry.
AWB_OLLAMA_STALL_CHECK_SECONDS=60
AWB_OLLAMA_HEALTH_TIMEOUT_SECONDS=5
AWB_OLLAMA_HEALTH_FAILURES=15
AWB_OLLAMA_PROGRESS_EVENT_SECONDS=60
# Logical output budget rather than a time budget. Set 0 to omit num_predict.
AWB_OLLAMA_MAX_OUTPUT_TOKENS=8192
# Legacy compatibility only; streaming generation no longer uses this as a deadline.
AWB_OLLAMA_READ_TIMEOUT_SECONDS=3600

# Clean-install disk preflight for local inference. The required model payload
# is ~7.8 GB; Docker/Ollama images, extraction/cache and workspace headroom
# require more.
AWB_INSTALL_FREE_GB=20

# Small-device memory policy: one local model loaded at a time, then release it
# after a short idle period so other always-on services can reclaim RAM.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=60s

# Local Docker default. For remote inference, replace with the private LAN or
# Tailscale address of the Ollama worker, e.g. http://100.x.y.z:11434.
OLLAMA_BASE_URL=http://ollama:11434

# Standalone Research Lab: owns bounded scientific computation. When both values
# are present, research/custom workspaces gain direct Lab, SymPy and bounded
# numerical counterexample-search tools.
RESEARCH_LAB_URL=http://research-lab:8300
RESEARCH_LAB_TOKEN=

# Tutor LLM: owns indexed documents/RAG. When configured, Expert can retrieve
# grounded chunks with document/page provenance without an extra tutor generation.
TUTOR_LLM_URL=http://tutor:8000
TUTOR_LLM_TOKEN=

# Optional cloud escalation. A ChatGPT subscription does not include API usage.
# Even with a key, no cloud call is made unless the workspace also enables
# escalation and configures a positive budget and call cap.
OPENAI_API_KEY=

# Expert My Rules inference placement.
# local  = bundled Ollama container on this machine
# remote = Expert My Rules stays here, Ollama runs on another private machine
AWB_INFERENCE_MODE=local
AWB_PORT=8100
AWB_OBSERVER_PORT=8101
AWB_LAB_PORT=8102

# Host resource envelope. Deploy computes AWB_OLLAMA_CPUS as 85% of logical CPUs.
# On the four-core ACEPC this is 3.4 CPUs, leaving about 15% aggregate CPU headroom
# for GoldenBull, Sportage and the OS. Other services may burst when Ollama is idle.
AWB_OLLAMA_CPU_FRACTION=0.85
AWB_SIDE_PROJECT_CPU_FRACTION=0.15
AWB_OLLAMA_CPUS=3.4

# Local-first heterogeneous ensemble.
AWB_PLANNER_MODEL=qwen3:4b
AWB_DIRECTOR_MODEL=qwen3:4b
AWB_WORKER_MODEL=qwen3:4b
AWB_REVIEWER_MODEL=llama3.2:3b
AWB_VERIFIER_MODEL=gemma3:4b
AWB_LOCAL_MODEL=qwen3:4b

# LM Studio is a second OpenAI-compatible local/remote compute node. The Setup UI
# discovers models from /v1/models and lets each role choose one from a dropdown.
# If LM Studio is on the ACEPC host, enable its local server on port 1234.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=

# Slow-machine inference policy.
AWB_OLLAMA_STALL_CHECK_SECONDS=60
AWB_OLLAMA_HEALTH_TIMEOUT_SECONDS=5
AWB_OLLAMA_HEALTH_FAILURES=15
AWB_OLLAMA_PROGRESS_EVENT_SECONDS=60
AWB_OLLAMA_MAX_OUTPUT_TOKENS=8192
AWB_OLLAMA_READ_TIMEOUT_SECONDS=3600

# Role-aware local budgets.
AWB_OLLAMA_DIRECTOR_MAX_OUTPUT_TOKENS=1200
AWB_OLLAMA_WORKER_MAX_OUTPUT_TOKENS=8192
AWB_OLLAMA_REVIEWER_MAX_OUTPUT_TOKENS=2200
AWB_OLLAMA_VERIFIER_MAX_OUTPUT_TOKENS=1200
AWB_OLLAMA_DIRECTOR_THINK=false
AWB_OLLAMA_WORKER_THINK=true

AWB_INSTALL_FREE_GB=20
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=60s
OLLAMA_BASE_URL=http://ollama:11434

# Paid API routing. Per-project burst caps and role/model choices are editable from
# Setup. AWB_MONTHLY_API_BUDGET_EUR seeds the global monthly hard ceiling. Once the
# ceiling is exhausted, new OpenAI calls are blocked before they start and work
# falls back to local model routes.
OPENAI_API_KEY=
AWB_MONTHLY_API_BUDGET_EUR=5.0
AWB_OPENAI_DIRECTOR_MODEL=gpt-5.6-terra
AWB_OPENAI_DIRECTOR_REASONING=low
AWB_OPENAI_DIRECTOR_MAX_OUTPUT_TOKENS=1200
AWB_OPENAI_WORKER_MODEL=gpt-5.6-sol
AWB_OPENAI_WORKER_REASONING=high
AWB_OPENAI_WORKER_MAX_OUTPUT_TOKENS=8192
AWB_OPENAI_REVIEWER_MODEL=gpt-5.6-sol
AWB_OPENAI_REVIEWER_REASONING=high
AWB_OPENAI_REVIEWER_MAX_OUTPUT_TOKENS=4096
AWB_OPENAI_VERIFIER_MODEL=gpt-5.6-terra
AWB_OPENAI_VERIFIER_REASONING=medium
AWB_OPENAI_VERIFIER_MAX_OUTPUT_TOKENS=1800
AWB_USD_PER_EUR=1.0

# Dedicated Research Lab container bundled with Expert My Rules.
RESEARCH_LAB_URL=http://expert-lab:8300
RESEARCH_LAB_TOKEN=awb-local-lab

# Tutor LLM / RAG.
TUTOR_LLM_URL=http://tutor:8000
TUTOR_LLM_TOKEN=
